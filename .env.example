APP_NAME="Eternity Insights"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8098
# Optional separate public document root for shared hosting
APP_PUBLIC_PATH=
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Main website database (WAMP MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=ei_db
DB_USERNAME=lk_local
DB_PASSWORD=""

# Separate legacy data connection; not merged with the main catalogue
REPORT_DB_HOST=127.0.0.1
REPORT_DB_PORT=3307
REPORT_DB_DATABASE=reportdb
REPORT_DB_USERNAME=lk_local
REPORT_DB_PASSWORD=""

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=eternity_laravel_session
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Change MAIL_MAILER to smtp after supplying real SMTP credentials
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_TIMEOUT=15
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@localhost.test"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS="admin@localhost.test"
MAIL_NOTIFICATIONS=true

GOOGLE_ANALYTICS_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
PAYPAL_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BUSINESS_EMAIL=
PAYPAL_CURRENCY=USD
SITE_SALES_EMAIL=sales@eternityinsights.com
SITE_PHONE="+91-930-705-6852"

# Managed by Admin > SMTP settings after the first save. Password uses APP_KEY encryption.
MAIL_SETTINGS_MANAGED=false
MAIL_SECURITY=tls
MAIL_PASSWORD_ENCRYPTED=

# Hidden copies of admin enquiry and checkout notifications (comma separated).
MAIL_ADMIN_BCC=
